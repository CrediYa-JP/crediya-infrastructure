# =============================================================================
# CREDIYA - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file as .env and fill with your actual values
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MySQL Root Password (shared by both databases)
MYSQL_ROOT_PASSWORD=

# Authentication Database
AUTH_DB_NAME=crediya_auth
AUTH_DB_USER=
AUTH_DB_PASSWORD=
AUTH_DB_EXTERNAL_PORT=3301

# Applications Database
APP_DB_NAME=crediya_applications
APP_DB_USER=
APP_DB_PASSWORD=
APP_DB_SCHEMA=crediya_applications
APP_DB_EXTERNAL_PORT=3302

# =============================================================================
# JWT CONFIGURATION
# =============================================================================

# JWT Private Key (for authentication service)
JWT_PRIVATE_KEY=

# JWT Public Key (shared by both services)
JWT_PUBLIC_KEY=

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed origins for CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080

# =============================================================================
# SERVICE PORTS (OPTIONAL - defaults provided)
# =============================================================================

# External ports for services (optional)
AUTH_SERVICE_EXTERNAL_PORT=8080
APP_SERVICE_EXTERNAL_PORT=8081